<mujoco model="Humanoid">
  <option timestep="0.005"/>

  <visual>
    <map force="0.1" zfar="30"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global offwidth="2560" offheight="1440" elevation="-20" azimuth="120"/>
  </visual>

  <statistic center="0 0 0.7"/>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1=".3 .5 .7" rgb2="0 0 0" width="32" height="512"/>
    <texture name="body" type="cube" builtin="flat" mark="cross" width="128" height="128" rgb1="0.8 0.6 0.4" rgb2="0.8 0.6 0.4" markrgb="1 1 1"/>
    <material name="body" texture="body" texuniform="true" rgba="0.8 0.6 .4 1"/>
    <texture name="grid" type="2d" builtin="checker" width="512" height="512" rgb1=".1 .2 .3" rgb2=".2 .3 .4"/>
    <material name="grid" texture="grid" texrepeat="1 1" texuniform="true" reflectance=".2"/>
  </asset>

  <default>
    <motor ctrlrange="-1 1" ctrllimited="true"/>
    <default class="body">

      <!-- geoms -->
      <geom type="capsule" condim="1" friction=".7" solimp=".9 .99 .003" solref=".015 1" material="body" group="1"/>
      <default class="thigh">
        <geom size=".06"/>
      </default>
      <default class="shin">
        <geom fromto="0 0 0 0 0 -.3"  size=".049"/>
      </default>
      <default class="foot">
        <geom size=".027"/>
        <default class="foot1">
          <geom fromto="-.07 -.01 0 .14 -.03 0"/>
        </default>
        <default class="foot2">
          <geom fromto="-.07 .01 0 .14  .03 0"/>
        </default>
      </default>
      <default class="arm_upper">
        <geom size=".04"/>
      </default>
      <default class="arm_lower">
        <geom size=".031"/>
      </default>
      <default class="hand">
        <geom type="sphere" size=".04"/>
      </default>
      <default class="finger">
        <geom type="capsule" size=".012" friction="1.5 .5 .5"/>
      </default>

      <!-- joints -->
      <joint type="hinge" damping=".2" stiffness="1" armature=".01" limited="true" solimplimit="0 .99 .01"/>
      <default class="joint_big">
        <joint damping="5" stiffness="10"/>
        <default class="hip_x">
          <joint range="-30 10"/>
        </default>
        <default class="hip_z">
          <joint range="-60 35"/>
        </default>
        <default class="hip_y">
          <joint axis="0 1 0" range="-150 20"/>
        </default>
        <default class="joint_big_stiff">
          <joint stiffness="20"/>
        </default>
      </default>
      <default class="knee">
        <joint pos="0 0 .02" axis="0 -1 0" range="-160 2"/>
      </default>
      <default class="ankle">
        <joint range="-50 50"/>
        <default class="ankle_y">
          <joint pos="0 0 .08" axis="0 1 0" stiffness="6"/>
        </default>
        <default class="ankle_x">
          <joint pos="0 0 .04" stiffness="3"/>
        </default>
      </default>
      <default class="shoulder">
        <joint range="-85 60"/>
      </default>
      <default class="elbow">
        <joint range="-100 50" stiffness="0"/>
      </default>

      <!-- Умеренная жёсткость для рук -->
      <default class="shoulder_rot">
        <joint stiffness="15" damping="1.5" armature=".005" range="-60 60"/>
      </default>
      <default class="forearm_twist">
        <joint stiffness="10" damping="1" armature=".005" range="-80 80"/>
      </default>
      <default class="wrist">
        <joint stiffness="10" damping="1" armature=".005" range="-30 30"/>
      </default>
      <default class="finger_flex">
        <joint stiffness="5" damping=".3" armature=".003" range="0 80"/>
      </default>
    </default>
  </default>

  <worldbody>
    <geom name="floor" size="0 0 .05" type="plane" material="grid" condim="3"/>
    <light name="spotlight" mode="targetbodycom" target="torso" diffuse=".8 .8 .8" specular="0.3 0.3 0.3" pos="0 -6 4" cutoff="30"/>
    <light name="top" pos="0 0 2" mode="trackcom"/>

    <body name="torso" pos="0 0 1.282" childclass="body">
      <camera name="back" pos="-3 0 1" xyaxes="0 -1 0 1 0 2" mode="trackcom"/>
      <camera name="side" pos="0 -3 1" xyaxes="1 0 0 0 1 2" mode="trackcom"/>
      <freejoint name="root"/>
      <geom name="torso" fromto="0 -.07 0 0 .07 0" size=".07"/>
      <geom name="waist_upper" fromto="-.01 -.06 -.12 -.01 .06 -.12" size=".06"/>

      <!-- Голова -->
      <body name="head" pos="0 0 .19">
        <geom name="head" type="sphere" size=".09"/>
        <camera name="egocentric" pos=".09 0 0" xyaxes="0 -1 0 .1 0 1" fovy="80"/>
      </body>

      <!-- Таз и ноги (ПОЛНОСТЬЮ из коробки) -->
      <body name="waist_lower" pos="-.01 0 -.26">
        <geom name="waist_lower" fromto="0 -.06 0 0 .06 0" size=".06"/>
        <joint name="abdomen_z" pos="0 0 .065" axis="0 0 1" range="-45 45" class="joint_big_stiff"/>
        <joint name="abdomen_y" pos="0 0 .065" axis="0 1 0" range="-75 30" class="joint_big"/>
        <body name="pelvis" pos="0 0 -.165">
          <joint name="abdomen_x" pos="0 0 .1" axis="1 0 0" range="-35 35" class="joint_big"/>
          <geom name="butt" fromto="-.02 -.07 0 -.02 .07 0" size=".09"/>

          <!-- Правая нога -->
          <body name="thigh_right" pos="0 -.1 -.04">
            <joint name="hip_x_right" axis="1 0 0" class="hip_x"/>
            <joint name="hip_z_right" axis="0 0 1" class="hip_z"/>
            <joint name="hip_y_right" class="hip_y"/>
            <geom name="thigh_right" fromto="0 0 0 0 .01 -.34" class="thigh"/>
            <body name="shin_right" pos="0 .01 -.4">
              <joint name="knee_right" class="knee"/>
              <geom name="shin_right" class="shin"/>
              <body name="foot_right" pos="0 0 -.39">
                <joint name="ankle_y_right" class="ankle_y"/>
                <joint name="ankle_x_right" class="ankle_x" axis="1 0 .5"/>
                <geom name="foot1_right" class="foot1"/>
                <geom name="foot2_right" class="foot2"/>
              </body>
            </body>
          </body>

          <!-- Левая нога -->
          <body name="thigh_left" pos="0 .1 -.04">
            <joint name="hip_x_left" axis="-1 0 0" class="hip_x"/>
            <joint name="hip_z_left" axis="0 0 -1" class="hip_z"/>
            <joint name="hip_y_left" class="hip_y"/>
            <geom name="thigh_left" fromto="0 0 0 0 -.01 -.34" class="thigh"/>
            <body name="shin_left" pos="0 -.01 -.4">
              <joint name="knee_left" class="knee"/>
              <geom name="shin_left" fromto="0 0 0 0 0 -.3" class="shin"/>
              <body name="foot_left" pos="0 0 -.39">
                <joint name="ankle_y_left" class="ankle_y"/>
                <joint name="ankle_x_left" class="ankle_x" axis="-1 0 -.5"/>
                <geom name="foot1_left" class="foot1"/>
                <geom name="foot2_left" class="foot2"/>
              </body>
            </body>
          </body>
        </body>
      </body>

      <!-- ==================== ПРАВАЯ РУКА (детализированная) ==================== -->
      <body name="upper_arm_right" pos="0 -.17 .06">
        <!-- 2 сустава плеча (база) -->
        <joint name="shoulder1_right" axis="2 1 1" class="shoulder"/>
        <joint name="shoulder2_right" axis="0 -1 1" class="shoulder"/>
        
        <!-- Внутренняя ротация плеча (подлопаточная) -->
        <body name="humerus_right" pos="0 0 0">
          <joint name="shoulder_rot_right" axis="0.577 -0.577 -0.577" class="shoulder_rot"/>
          
          <!-- Локтевая кость (реальный бицепс/трицепс) -->
          <body name="ulna_right" pos="0 0 0">
            <joint name="elbow_right" axis="0 -1 1" class="elbow"/>
            
            <!-- Лучевая кость (для пронации/супинации) -->
            <body name="radius_right" pos="0 0 0">
              <joint name="forearm_twist_right" axis="0.577 0.577 0.577" class="forearm_twist"/>
              
              <!-- Кисть с двумя суставами -->
              <body name="wrist_right" pos="0 0 0">
                <joint name="wrist_flex_right" axis="1 0 0" class="wrist"/>
                <body name="wrist_abduct_right" pos="0 0 0">
                  <joint name="wrist_abduct_right" axis="0 1 0" class="wrist"/>
                  <geom name="hand_right" type="sphere" size=".045" material="body" group="1"/>
                  
                  <!-- Сгибатель/разгибатель пальцев (все пальцы одним мотором) -->
                  <body name="fingers_right" pos="0 0 0">
                    <joint name="fingers_flex_right" axis="1 0 0" class="finger_flex"/>
                    <geom name="index_right" fromto=".04 .015 0 .08 .03 0" class="finger"/>
                    <geom name="middle_right" fromto=".04 0 0 .08 0 0" class="finger"/>
                    <geom name="ring_right" fromto=".04 -.015 0 .08 -.03 0" class="finger"/>
                    <geom name="pinky_right" fromto=".035 -.03 0 .06 -.05 0" class="finger"/>
                    <!-- Большой палец (отдельный сустав для оппозиции) -->
                    <body name="thumb_right" pos=".04 .02 .01">
                      <joint name="thumb_flex_right" axis="0 1 0" class="finger_flex"/>
                      <geom name="thumb_right" fromto="0 0 0 .03 .01 0" class="finger"/>
                    </body>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>

      <!-- ==================== ЛЕВАЯ РУКА (зеркально) ==================== -->
      <body name="upper_arm_left" pos="0 .17 .06">
        <joint name="shoulder1_left" axis="-2 1 -1" class="shoulder"/>
        <joint name="shoulder2_left" axis="0 -1 -1" class="shoulder"/>
        <body name="humerus_left" pos="0 0 0">
          <joint name="shoulder_rot_left" axis="0.577 0.577 -0.577" class="shoulder_rot"/>
          <body name="ulna_left" pos="0 0 0">
            <joint name="elbow_left" axis="0 -1 -1" class="elbow"/>
            <body name="radius_left" pos="0 0 0">
              <joint name="forearm_twist_left" axis="0.577 -0.577 0.577" class="forearm_twist"/>
              <body name="wrist_left" pos="0 0 0">
                <joint name="wrist_flex_left" axis="1 0 0" class="wrist"/>
                <body name="wrist_abduct_left" pos="0 0 0">
                  <joint name="wrist_abduct_left" axis="0 1 0" class="wrist"/>
                  <geom name="hand_left" type="sphere" size=".045" material="body" group="1"/>
                  <body name="fingers_left" pos="0 0 0">
                    <joint name="fingers_flex_left" axis="1 0 0" class="finger_flex"/>
                    <geom name="index_left" fromto=".04 -.015 0 .08 -.03 0" class="finger"/>
                    <geom name="middle_left" fromto=".04 0 0 .08 0 0" class="finger"/>
                    <geom name="ring_left" fromto=".04 .015 0 .08 .03 0" class="finger"/>
                    <geom name="pinky_left" fromto=".035 .03 0 .06 .05 0" class="finger"/>
                    <body name="thumb_left" pos=".04 -.02 .01">
                      <joint name="thumb_flex_left" axis="0 -1 0" class="finger_flex"/>
                      <geom name="thumb_left" fromto="0 0 0 .03 -.01 0" class="finger"/>
                    </body>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <!-- Контакты (из коробки) -->
  <contact>
    <exclude body1="waist_lower" body2="thigh_right"/>
    <exclude body1="waist_lower" body2="thigh_left"/>
  </contact>

  <!-- Сухожилия (из коробки) -->
  <tendon>
    <fixed name="hamstring_right" limited="true" range="-0.3 2">
      <joint joint="hip_y_right" coef=".5"/>
      <joint joint="knee_right" coef="-.5"/>
    </fixed>
    <fixed name="hamstring_left" limited="true" range="-0.3 2">
      <joint joint="hip_y_left" coef=".5"/>
      <joint joint="knee_left" coef="-.5"/>
    </fixed>
  </tendon>

  <!-- Актуаторы: только нужные мышцы -->
  <actuator>
    <!-- Ноги и корпус (из коробки) -->
    <motor name="abdomen_z"       gear="40"  joint="abdomen_z"/>
    <motor name="abdomen_y"       gear="40"  joint="abdomen_y"/>
    <motor name="abdomen_x"       gear="40"  joint="abdomen_x"/>
    <motor name="hip_x_right"     gear="40"  joint="hip_x_right"/>
    <motor name="hip_z_right"     gear="40"  joint="hip_z_right"/>
    <motor name="hip_y_right"     gear="120" joint="hip_y_right"/>
    <motor name="knee_right"      gear="80"  joint="knee_right"/>
    <motor name="ankle_y_right"   gear="20"  joint="ankle_y_right"/>
    <motor name="ankle_x_right"   gear="20"  joint="ankle_x_right"/>
    <motor name="hip_x_left"      gear="40"  joint="hip_x_left"/>
    <motor name="hip_z_left"      gear="40"  joint="hip_z_left"/>
    <motor name="hip_y_left"      gear="120" joint="hip_y_left"/>
    <motor name="knee_left"       gear="80"  joint="knee_left"/>
    <motor name="ankle_y_left"    gear="20"  joint="ankle_y_left"/>
    <motor name="ankle_x_left"    gear="20"  joint="ankle_x_left"/>

    <!-- === МЫШЦЫ ПРАВОЙ РУКИ === -->
    <!-- 3 сгибателя локтя -->
    <motor name="biceps_right"        gear="30" joint="elbow_right"/>
    <motor name="brachialis_right"    gear="20" joint="elbow_right"/>
    <motor name="brachioradialis_right" gear="15" joint="elbow_right"/>
    
    <!-- Разгибатель локтя -->
    <motor name="triceps_right"       gear="-35" joint="elbow_right"/>
    
    <!-- Пронатор (на лучевой кости) -->
    <motor name="pronator_right"      gear="-20" joint="forearm_twist_right"/>
    
    <!-- Широчайшая (плечо) -->
    <motor name="latissimus_right"    gear="25" joint="shoulder1_right" ctrlrange="-1 0"/>
    
    <!-- Подлопаточная (внутренняя ротация) -->
    <motor name="subscapularis_right" gear="20" joint="shoulder_rot_right"/>
    
    <!-- Приводящая/отводящая кисть -->
    <motor name="wrist_abduct_right"  gear="15" joint="wrist_abduct_right"/>
    
    <!-- Сгибатель/разгибатель пальцев (групповой) -->
    <motor name="fingers_flex_right"  gear="10" joint="fingers_flex_right"/>
    <motor name="thumb_flex_right"    gear="8"  joint="thumb_flex_right"/>

    <!-- === МЫШЦЫ ЛЕВОЙ РУКИ (зеркально) === -->
    <motor name="biceps_left"        gear="30" joint="elbow_left"/>
    <motor name="brachialis_left"    gear="20" joint="elbow_left"/>
    <motor name="brachioradialis_left" gear="15" joint="elbow_left"/>
    <motor name="triceps_left"       gear="-35" joint="elbow_left"/>
    <motor name="pronator_left"      gear="-20" joint="forearm_twist_left"/>
    <motor name="latissimus_left"    gear="25" joint="shoulder1_left" ctrlrange="-1 0"/>
    <motor name="subscapularis_left" gear="20" joint="shoulder_rot_left"/>
    <motor name="wrist_abduct_left"  gear="15" joint="wrist_abduct_left"/>
    <motor name="fingers_flex_left"  gear="10" joint="fingers_flex_left"/>
    <motor name="thumb_flex_left"    gear="8"  joint="thumb_flex_left"/>
  </actuator>

  <!-- Сенсоры (только нужные) -->
  <sensor>
    <!-- Углы и скорости для 8 ключевых суставов -->
    <jointpos name="shoulder1_right_pos" joint="shoulder1_right"/>
    <jointvel name="shoulder1_right_vel" joint="shoulder1_right"/>
    
    <jointpos name="shoulder_rot_right_pos" joint="shoulder_rot_right"/>
    <jointvel name="shoulder_rot_right_vel" joint="shoulder_rot_right"/>
    
    <jointpos name="elbow_right_pos" joint="elbow_right"/>
    <jointvel name="elbow_right_vel" joint="elbow_right"/>
    
    <jointpos name="forearm_twist_right_pos" joint="forearm_twist_right"/>
    <jointvel name="forearm_twist_right_vel" joint="forearm_twist_right"/>
    
    <jointpos name="wrist_flex_right_pos" joint="wrist_flex_right"/>
    <jointvel name="wrist_flex_right_vel" joint="wrist_flex_right"/>
    
    <jointpos name="wrist_abduct_right_pos" joint="wrist_abduct_right"/>
    <jointvel name="wrist_abduct_right_vel" joint="wrist_abduct_right"/>
    
    <jointpos name="fingers_flex_right_pos" joint="fingers_flex_right"/>
    <jointvel name="fingers_flex_right_vel" joint="fingers_flex_right"/>

    <!-- Для левой руки (симметрично) -->
    <jointpos name="shoulder1_left_pos" joint="shoulder1_left"/>
    <jointvel name="shoulder1_left_vel" joint="shoulder1_left"/>
    
    <jointpos name="shoulder_rot_left_pos" joint="shoulder_rot_left"/>
    <jointvel name="shoulder_rot_left_vel" joint="shoulder_rot_left"/>
    
    <jointpos name="elbow_left_pos" joint="elbow_left"/>
    <jointvel name="elbow_left_vel" joint="elbow_left"/>
    
    <jointpos name="forearm_twist_left_pos" joint="forearm_twist_left"/>
    <jointvel name="forearm_twist_left_vel" joint="forearm_twist_left"/>
    
    <jointpos name="wrist_flex_left_pos" joint="wrist_flex_left"/>
    <jointvel name="wrist_flex_left_vel" joint="wrist_flex_left"/>
    
    <jointpos name="wrist_abduct_left_pos" joint="wrist_abduct_left"/>
    <jointvel name="wrist_abduct_left_vel" joint="wrist_abduct_left"/>
    
    <jointpos name="fingers_flex_left_pos" joint="fingers_flex_left"/>
    <jointvel name="fingers_flex_left_vel" joint="fingers_flex_left"/>

    <!-- Контактные силы на кистях (для ощущения сопротивления) -->
    <contactforce name="hand_right_contact" site1="hand_right"/>
    <contactforce name="hand_left_contact"  site1="hand_left"/>
  </sensor>

  <!-- Ключевые позы (из коробки) -->
  <keyframe>
    <key name="squat"
         qpos="0 0 0.596
               0.988015 0 0.154359 0
               0 0.4 0
               -0.25 -0.5 -2.5 -2.65 -0.8 0.56
               -0.25 -0.5 -2.5 -2.65 -0.8 0.56
               0 0 0 0 0 0"/>
    <key name="stand_on_left_leg"
         qpos="0 0 1.21948
               0.971588 -0.179973 0.135318 -0.0729076
               -0.0516 -0.202 0.23
               -0.24 -0.007 -0.34 -1.76 -0.466 -0.0415
               -0.08 -0.01 -0.37 -0.685 -0.35 -0.09
               0.109 -0.067 -0.7 -0.05 0.12 0.16"/>
    <key name="prone"
         qpos="0.4 0 0.0757706
               0.7325 0 0.680767 0
               0 0.0729 0
               0.0077 0.0019 -0.026 -0.351 -0.27 0
               0.0077 0.0019 -0.026 -0.351 -0.27 0
               0.56 -0.62 -1.752
               0.56 -0.62 -1.752"/>
    <key name="supine"
         qpos="-0.4 0 0.08122
               0.722788 0 -0.69107 0
               0 -0.25 0
               0.0182 0.0142 0.3 0.042 -0.44 -0.02
               0.0182 0.0142 0.3 0.042 -0.44 -0.02
               0.186 -0.73 -1.73
               0.186 -0.73 -1.73"/>
  </keyframe>
</mujoco>